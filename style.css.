
/* =====================================================
   GLOBEXA — CODE 2
   DESIGN MARKETPLACE INTERNATIONAL
   ===================================================== */

:root {
  --primary: #222f3e;
  --primary-light: #34495e;
  --orange: #ff6a00;
  --orange-dark: #e85d00;
  --background: #f5f5f5;
  --white: #ffffff;
  --text: #222222;
  --muted: #666666;
  --border: #e5e5e5;
  --success: #16834a;
  --shadow: 0 2px 9px rgba(0,0,0,.07);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--text);
  font-family: Roboto, Arial, sans-serif;
  font-size: 14px;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: .55;
}

img,
video {
  max-width: 100%;
}

[hidden] {
  display: none !important;
}

/* BARRE SUPERIEURE */

.topbar {
  min-height: 36px;
  padding: 7px 4%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  background: var(--primary);
  color: white;
  font-size: 12px;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 22px;
}

.topbar a {
  color: white;
}

.topbar a:hover {
  color: #ffb27e;
}

.topbar select {
  border: 0;
  border-radius: 3px;
  padding: 5px 8px;
  color: #222;
  background: white;
}

/* EN-TETE */

.header {
  min-height: 92px;
  padding: 17px 4%;
  background: white;
  display: grid;
  grid-template-columns: 185px minmax(250px, 1fr) auto;
  align-items: center;
  gap: 25px;
  border-bottom: 1px solid var(--border);
}

.logo {
  display: inline-block;
  color: var(--primary);
  font-size: 31px;
  font-weight: 800;
  letter-spacing: -1.5px;
}

.logo span {
  color: var(--orange);
}

.search {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: stretch;
  border: 2px solid var(--orange);
  border-radius: 28px;
  padding: 3px;
  overflow: hidden;
  background: white;
}

.search input {
  flex: 1;
  min-width: 0;
  padding: 11px 15px;
  border: 0;
  outline: 0;
  background: transparent;
}

.search select {
  max-width: 125px;
  padding: 0 8px;
  border: 0;
  border-left: 1px solid var(--border);
  outline: 0;
  background: white;
  color: #444;
}

.search button,
.primary-button {
  border: 0;
  border-radius: 24px;
  padding: 11px 24px;
  background: var(--orange);
  color: white;
  font-weight: 700;
  white-space: nowrap;
}

.search button:hover,
.primary-button:hover {
  background: var(--orange-dark);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 22px;
}

.header-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  color: #333;
  font-size: 12px;
}

.header-action:hover {
  color: var(--orange);
}

.header-icon {
  font-size: 22px;
}

#cartCount {
  color: var(--orange);
  font-weight: 800;
}

/* NAVIGATION */

.main-nav {
  background: white;
  border-bottom: 1px solid var(--border);
}

.nav-inner {
  max-width: 1500px;
  margin: auto;
  padding: 0 4%;
  min-height: 48px;
  display: flex;
  align-items: center;
  gap: 28px;
  overflow-x: auto;
  white-space: nowrap;
}

.nav-inner a {
  color: #333;
  font-size: 13px;
  font-weight: 600;
}

.nav-inner a:hover {
  color: var(--orange);
}

.nav-inner .nav-category {
  color: var(--primary);
  font-weight: 800;
}

/* CONTENU */

main {
  width: 100%;
  max-width: 1500px;
  margin: 20px auto;
  padding: 0 22px;
}

/* ACCUEIL PRINCIPAL */

.home-layout {
  display: grid;
  grid-template-columns: 245px minmax(300px, 1fr) 245px;
  gap: 14px;
  align-items: stretch;
}

.category-panel,
.hero-banner,
.welcome-card {
  border-radius: 7px;
  background: white;
  box-shadow: var(--shadow);
}

.category-panel {
  padding: 17px 14px;
  overflow: hidden;
}

.panel-heading {
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}

.panel-heading h2 {
  margin: 0;
  font-size: 16px;
  font-weight: 700;
}

.category-list {
  display: flex;
  flex-direction: column;
}

.category-list a,
.category-list button,
.category-list > div {
  display: block;
  width: 100%;
  padding: 12px 7px;
  border: 0;
  border-bottom: 1px solid #f0f0f0;
  border-radius: 0;
  background: transparent;
  color: #444;
  text-align: left;
  font-size: 13px;
}

.category-list a:hover,
.category-list button:hover {
  background: #fff5ed;
  color: var(--orange);
}

/* GRANDE BANNIERE */

.hero-banner {
  min-height: 340px;
  padding: 34px;
  display: grid;
  grid-template-columns: 1.2fr .8fr;
  align-items: center;
  gap: 15px;
  overflow: hidden;
  background: linear-gradient(115deg, #e7f1f9, #fff0e5);
}

.hero-label {
  color: var(--orange);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1px;
}

.hero-content h1 {
  max-width: 570px;
  margin: 15px 0;
  color: var(--primary);
  font-size: clamp(27px, 3vw, 40px);
  line-height: 1.16;
}

.hero-content p {
  max-width: 500px;
  color: #555;
  font-size: 15px;
  line-height: 1.7;
  margin-bottom: 24px;
}

.primary-button {
  display: inline-block;
  font-size: 13px;
}

.hero-image-area {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-image-placeholder {
  width: 100%;
  min-height: 190px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: linear-gradient(140deg, #d5e5f1, #ffd8bd);
  color: var(--primary);
  font-size: 27px;
  font-weight: 800;
  letter-spacing: 3px;
}

/* CARTES DE BIENVENUE */

.welcome-panel {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.welcome-card {
  flex: 1;
  padding: 18px;
  border: 1px solid #eeeeee;
}

.welcome-icon {
  font-size: 25px;
}

.welcome-card h3 {
  margin: 10px 0;
  font-size: 15px;
}

.welcome-card p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.welcome-card a {
  display: inline-block;
  margin-top: 7px;
  color: var(--orange);
  font-weight: 700;
  font-size: 12px;
}

.supplier-welcome {
  background: #fffaf5;
}

/* SERVICES RAPIDES */

.quick-services {
  margin: 16px 0;
  padding: 16px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  border-radius: 7px;
  background: white;
  box-shadow: var(--shadow);
}

.quick-service {
  min-height: 75px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border: 1px solid #eeeeee;
  border-radius: 6px;
  color: #333;
}

.quick-service span {
  font-size: 25px;
}

.quick-service strong {
  font-size: 12px;
}

.quick-service:hover {
  border-color: var(--orange);
  color: var(--orange);
}

/* SECTIONS */

.section {
  margin: 18px 0;
  padding: 22px;
  border-radius: 7px;
  background: white;
  box-shadow: var(--shadow);
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
}

.section-heading h2 {
  margin: 0;
  color: #222;
  font-size: 21px;
}

.section-heading p {
  margin: 6px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.muted,
.loading-text {
  color: var(--muted);
  font-size: 13px;
}

/* CARTES PRODUITS */

.product-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 14px;
}

.product-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid #e8e8e8;
  border-radius: 6px;
  background: white;
  transition: box-shadow .2s, transform .2s;
}

.product-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 16px rgba(0,0,0,.12);
}

.product-card img {
  display: block;
  width: 100%;
  height: 185px;
  object-fit: cover;
  background: #f4f4f4;
}

.product-card h3 {
  margin: 12px 12px 7px;
  color: #333;
  font-size: 14px;
  line-height: 1.45;
}

.product-card p {
  margin: 7px 12px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.5;
}

.product-card .price {
  color: var(--orange);
  font-size: 17px;
  font-weight: 800;
}

.product-card button {
  margin: 10px 12px 13px;
  padding: 9px 13px;
  border: 1px solid var(--orange);
  border-radius: 4px;
  background: white;
  color: var(--orange);
  font-size: 12px;
  font-weight: 700;
}

.product-card button:hover {
  background: var(--orange);
  color: white;
}

/* FOURNISSEURS */

.supplier-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.supplier-card {
  min-width: 0;
  padding: 16px;
  border: 1px solid #e8e8e8;
  border-radius: 6px;
  background: white;
}

.supplier-card img {
  width: 100%;
  height: 130px;
  object-fit: cover;
  border-radius: 4px;
  background: #f5f5f5;
}

.supplier-card h3 {
  margin: 12px 0 7px;
  font-size: 15px;
}

.supplier-card p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.5;
}

/* REELS */

.reel-grid,
#reelFeed {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

#reelFeed video {
  width: 100%;
  max-height: 430px;
  border-radius: 7px;
  background: #111;
  object-fit: cover;
}

.reels-section {
  overflow: hidden;
}

/* PANNEAUX ET FORMULAIRES */

.panel {
  padding: 20px;
  border: 1px solid var(--border);
  border-radius: 7px;
  background: white;
}

.panel h3 {
  margin-top: 0;
}

.auth-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.form-box {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.form-box label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  color: #333;
  font-size: 13px;
  font-weight: 600;
}

.form-box input,
.form-box select,
.form-box textarea {
  width: 100%;
  min-height: 42px;
  padding: 10px 12px;
  border: 1px solid #d8d8d8;
  border-radius: 4px;
  background: white;
  color: #222;
  outline: none;
}

.form-box input:focus,
.form-box select:focus,
.form-box textarea:focus {
  border-color: var(--orange);
  box-shadow: 0 0 0 2px rgba(255,106,0,.1);
}

.form-box button,
#checkoutButton,
#logoutButton {
  min-height: 42px;
  padding: 11px 17px;
  border: 0;
  border-radius: 4px;
  background: var(--orange);
  color: white;
  font-weight: 700;
}

.form-box button:hover,
#checkoutButton:hover,
#logoutButton:hover {
  background: var(--orange-dark);
}

.message {
  margin-top: 14px;
  padding: 12px;
  border-radius: 5px;
  background: #f2f6fa;
  color: #333;
  font-size: 13px;
}

.message.success {
  background: #e8f7ee;
  color: #176b3a;
}

.message.error {
  background: #fff0ef;
  color: #a52a20;
}

/* PANIER */

#cartItems {
  margin: 15px 0;
}

#cartTotal {
  margin: 15px 0;
  font-size: 18px;
  font-weight: 800;
}

/* DETAIL PRODUIT */

.product-modal {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  overflow-y: auto;
  padding: 25px;
  background: rgba(0,0,0,.68);
}

.product-modal-content {
  position: relative;
  width: 100%;
  max-width: 850px;
  min-height: 180px;
  margin: 25px auto;
  padding: 25px;
  border-radius: 9px;
  background: white;
}

.modal-close {
  position: sticky;
  top: 0;
  float: right;
  z-index: 2;
  padding: 9px 13px;
  border: 0;
  border-radius: 4px;
  background: var(--primary);
  color: white;
}

/* PIED DE PAGE */

.footer {
  margin-top: 30px;
  padding: 35px 5% 18px;
  background: var(--primary);
  color: white;
}

.footer-brand {
  text-align: center;
}

.footer-logo {
  color: white;
}

.footer-brand p {
  color: #e0e5ea;
  font-size: 13px;
}

.footer-links {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 22px;
  margin: 25px 0;
}

.footer-links a {
  color: white;
  font-size: 13px;
}

.footer-links a:hover {
  color: #ffb27e;
}

.footer-bottom {
  padding-top: 15px;
  border-top: 1px solid #ffffff33;
  color: #d8dfe6;
  text-align: center;
  font-size: 12px;
}

/* AFFICHAGE TABLETTE */

@media (max-width: 1100px) {
  .header {
    grid-template-columns: 150px minmax(200px, 1fr);
  }

  .header-actions {
    grid-column: 1 / -1;
    justify-content: flex-end;
  }

  .home-layout {
    grid-template-columns: 220px minmax(0, 1fr);
  }

  .welcome-panel {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .product-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .supplier-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

/* AFFICHAGE TELEPHONE */

@media (max-width: 700px) {
  body {
    font-size: 13px;
  }

  .topbar {
    padding: 8px 12px;
    font-size: 10px;
  }

  .topbar-right {
    gap: 9px;
  }

  .topbar-right a {
    display: none;
  }

  .header {
    grid-template-columns: 1fr auto;
    gap: 12px;
    padding: 13px;
  }

  .logo {
    font-size: 26px;
  }

  .search {
    grid-column: 1 / -1;
    grid-row: 2;
    border-radius: 6px;
  }

  .search input {
    padding: 10px;
    font-size: 12px;
  }

  .search select {
    max-width: 85px;
    font-size: 11px;
  }

  .search button {
    padding: 10px 12px;
    border-radius: 4px;
    font-size: 11px;
  }

  .header-actions {
    grid-column: auto;
    gap: 12px;
  }

  .header-action {
    font-size: 10px;
  }

  .header-icon {
    font-size: 19px;
  }

  .nav-inner {
    min-height: 43px;
    padding: 0 12px;
    gap: 20px;
  }

  .nav-inner a {
    font-size: 12px;
  }

  main {
    margin: 12px auto;
    padding: 0 10px;
  }

  .home-layout {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hero-banner {
    min-height: 250px;
    padding: 22px;
    grid-template-columns: 1fr;
  }

  .hero-content h1 {
    font-size: 27px;
  }

  .hero-content p {
    font-size: 13px;
  }

  .hero-image-area {
    display: none;
  }

  .welcome-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .welcome-card {
    padding: 13px;
  }

  .category-panel {
    order: 4;
  }

  .quick-services {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    padding: 10px;
  }

  .quick-service {
    min-height: 65px;
    padding: 8px;
    gap: 7px;
  }

  .quick-service span {
    font-size: 20px;
  }

  .quick-service strong {
    font-size: 10px;
  }

  .section {
    margin: 12px 0;
    padding: 13px;
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 7px;
  }

  .section-heading h2 {
    font-size: 18px;
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .product-card img {
    height: 145px;
  }

  .product-card h3 {
    margin: 9px;
    font-size: 12px;
  }

  .product-card p {
    margin: 6px 9px;
    font-size: 11px;
  }

  .product-card .price {
    font-size: 15px;
  }

  .product-card button {
    margin: 8px;
    padding: 8px 10px;
    font-size: 11px;
  }

  .supplier-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .reel-grid,
  #reelFeed {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .auth-grid {
    grid-template-columns: 1fr;
  }

  .panel {
    padding: 14px;
  }

  .product-modal {
    padding: 10px;
  }

  .product-modal-content {
    padding: 15px;
    margin: 10px auto;
  }

  .footer {
    padding: 25px 15px 15px;
  }

  .footer-links {
    gap: 13px;
  }
}

@media (max-width: 380px) {
  .search select {
    display: none;
  }

  .header-actions {
    gap: 8px;
  }

  .welcome-card h3 {
    font-size: 13px;
  }
}
